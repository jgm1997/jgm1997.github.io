---
import ContactForm from "../components/ContactForm.astro";
import ContribGraph from "../components/ContribGraph.astro";
import GithubRepos from "../components/GithubRepos.astro";
import Hero from "../components/Hero.astro";
import TechStack from "../components/TechStack.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContributions, getRepos } from "../lib/github";

const repos = await getRepos();
const contributions = await getContributions();
---

<BaseLayout>
    <div id="about"><Hero/></div>
    <div id="stack"><TechStack /></div>
    <div id="repos"><GithubRepos repos={repos} /></div>
    <div id="contributions"><ContribGraph data={contributions} /></div>
    <div id="contact"><ContactForm /></div>
</BaseLayout>
