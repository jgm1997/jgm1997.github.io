---
const stack = [
    {
        category: "Languages",
        items: [
            { name: "Python", color: "#3776AB" },
            { name: "TypeScript", color: "#3178C6" },
            { name: "JavaScript", color: "#F7DF1E" },
        ],
    },
    {
        category: "Backend & Frameworks",
        items: [
            { name: "FastAPI", color: "#009688" },
            { name: "NestJS", color: "#E0234E" },
            { name: "Node.js", color: "#339933" },
        ],
    },
    {
        category: "Databases",
        items: [
            { name: "PostgreSQL", color: "#4169E1" },
            { name: "MySQL", color: "#4479A1" },
            { name: "TimescaleDB", color: "#FDB515" },
        ],
    },
    {
        category: "DevOps & Tooling",
        items: [
            { name: "Docker", color: "#2496ED" },
            { name: "GitLab CI", color: "#FC6D26" },
            { name: "Git", color: "#F05032" },
        ],
    },
    {
        category: "Testing",
        items: [
            { name: "Pytest", color: "#0A9EDC" },
            { name: "Jest", color: "#C21325" },
        ],
    },
    {
        category: "Exploring",
        items: [
            { name: "Rust", color: "#CE422B" },
            { name: "Kotlin", color: "#7F52FF" },
            { name: "Java", color: "#ED8B00" },
            { name: "Go", color: "#00ADD8" },
            { name: "Chi", color: "#00ADD8" },
            { name: "Redis", color: "#FA4438" },
            { name: "ClickHouse", color: "#FAFF69" },
            { name: "Kafka", color: "#000000" },
        ],
    },
];
---

<section class="space-y-8">
    <div>
        <p class="text-zinc-400 text-sm uppercase tracking-widest mb-1">
            What I work with
        </p>
        <h2 class="text-3xl font-bold text-white">Tech Stack</h2>
    </div>

    <div class="space-y-6">
        {
            stack.map(({ category, items }) => (
                <div>
                    <h3 class="text-zinc-400 text-xs uppercase tracking-widest mb-3">
                        {category}
                    </h3>
                    <div class="flex flex-wrap gap-2">
                        {items.map(({ name, color }) => (
                            <span
                                class="px-3 py-1.5 rounded-lg text-sm font-medium bg-zinc-800 hover:bg-zinc-700 transition-colors border border-zinc-700"
                                style={`border-left: 3px solid ${color}`}
                            >
                                {name}
                            </span>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</section>
