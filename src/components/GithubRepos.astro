---
interface Repo {
  id: number;
  name: string;
  description: string | null;
  html_url: string;
  stargazers_count: number;
  forks_count: number;
  language: string | null;
  updated_at: string;
  topics: string[];
  fork: boolean;
}

interface Props {
  repos: Repo[];
}

const { repos } = Astro.props;

const filtered = repos
  .filter((r) => !r.fork)
  .sort(
    (a, b) =>
      b.stargazers_count - a.stargazers_count ||
      new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime(),
  )
  .slice(0, 6);

const languageColors: Record<string, string> = {
  Python: "#3776AB",
  TypeScript: "#3178C6",
  JavaScript: "#F7DF1E",
  Go: "#00ADD8",
  Kotlin: "#7F52FF",
  Rust: "#CE422B",
  Java: "#ED8B00",
  Astro: "#FF5F5F",
};
---

<section class="space-y-8">
  <div>
    <p class="text-zinc-400 text-sm uppercase tracking-widest mb-1">
      What I've built
    </p>
    <h2 class="text-3xl font-bold text-white">Repositories</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      filtered.map((repo) => (
        <a
          href={repo.html_url}
          target="_blank"
          class="group flex flex-col justify-between p-5 rounded-xl bg-zinc-800 border border-zinc-700 hover:border-indigo-500 transition-colors"
        >
          <div class="space-y-2">
            <h3 class="font-semibold text-white group-hover:text-indigo-400 transition-colors">
              {repo.name}
            </h3>
            <p class="text-zinc-400 text-sm leading-relaxed">
              {repo.description ?? "No description provided"}
            </p>
            {repo.topics.length > 0 && (
              <div class="flex flex-wrap gap-1 pt-1">
                {repo.topics.map((topic) => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-zinc-700 text-zinc-300">
                    {topic}
                  </span>
                ))}
              </div>
            )}
          </div>

          <!-- Footer: language + stats -->
          <div class="flex items-center gap-4 mt-4 text-zinc-400 text-xs">
            {repo.language && (
                <span class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${languageColors[repo.language] || "#71717a"}`} />
                    {repo.language}
                </span>
            )}
            <span>⭐ {repo.stargazers_count}</span>
            <span>🍴 {repo.forks_count}</span>
            <span class="ml-auto">
                {new Date(repo.updated_at).toLocaleDateString("en-GB", { month: "short", year: "numeric" })}
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <div class="text-center">
    <a href={`https://github.com/${import.meta.env.GITHUB_USERNAME}`} target="_blank" class="text-sm text-indigo-400 hover:text-indigo-300 transition-colors">
    View all repositories on Github →</a>
  </div>
</section>
