---
const formspreeUrl = import.meta.env.FORMSPREE_URL;
---

<section class="space-y-8">
  <div>
    <p class="text-zinc-400 text-sm uppercase tracking-widest mb-1">
      Get in touch
    </p>
    <h2 class="text-3xl font-bold text-white">Contact</h2>
  </div>

  <div class="bg-zinc-800 border border-bg-zinc-700 rounded-xl p-6 space-y-4">
    <form id="contact-form" class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-1">
          <label for="name" class="text-zinc-400 text-sm">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="John Doe"
            class="w-full px-4 py-2.5 rounded-lg bg-zinc-900 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:border-indigo-500 transition-colors text-sm"
          />
        </div>

        <div class="space-y-1">
          <label for="email" class="text-zinc-400 text-sm">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="john.doe@example.com"
            class="w-full px-4 py-2.5 rounded-lg bg-zinc-900 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:border-indigo-500 transition-colors text-sm"
          />
        </div>
      </div>

      <div class="space-y-1">
        <label for="message" class="text-zinc-400 text-sm">Message</label>
        <textarea
          id="message"
          name="message"
          required
          placeholder="Your message"
          class="w-full px-4 py-2.5 rounded-lg bg-zinc-900 border border-zinc-700 text-white placeholder-zinc-500 focus:outline-none focus:border-indigo-500 transition-colors text-sm"
        ></textarea>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-medium rounded-lg transition-colors"
        >Send message</button
      >

      <!-- Status messages -->
      <p id="success-msg" class="hidden text-green-400 text-sm text-center">
        ✅ Message sent! I'll get back to you soon.
      </p>
      <p id="error-msg" class="hidden text-red-400 text-sm text-center">
        ❌ Something went wrong. Please try again or email me directly.
      </p>
    </form>
  </div>
</section>

<script define:vars={{ formspreeUrl }}>
  const form = document.getElementById("contact-form");
  const btn = document.getElementById("submit-btn");
  const successMsg = document.getElementById("success-msg");
  const errorMsg = document.getElementById("error-msg");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = "Sending...";
    successMsg.classList.add("hidden");
    errorMsg.classList.add("hidden");

    try {
      const res = await fetch(formspreeUrl, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });

      if (res.ok) {
        form.reset();
        successMsg.classList.remove("hidden");
      } else {
        errorMsg.classList.remove("hidden");
      }
    } catch {
      errorMsg.classList.remove("hidden");
    } finally {
      btn.disabled = false;
      btn.textContent = "Send message";
    }
  });
</script>
