---
interface ContributionDaily {
  date: string;
  contributionCount: number;
  color: string;
}

interface Week {
  contributionDays: ContributionDaily[];
}

interface Props {
  data: any;
}

const { data } = Astro.props;

const calendar =
  data?.data?.user?.contributionsCollection?.contributionCalendar;
const weeks: Week[] = calendar?.weeks ?? [];
const total: number = calendar?.totalContributions ?? 0;

function getColor(count: number): string {
  switch (true) {
    case count === 0:
      return "bg-zinc-700";
    case count <= 3:
      return "bg-indigo-900";
    case count <= 6:
      return "bg-indigo-700";
    case count <= 9:
      return "bg-indigo-500";
    default:
      return "bg-indigo-400";
  }
}

const days = ["Mon", "", "Wed", "", "Fri", "", ""];
---

<section class="space-y-8">
  <div>
    <p class="text-zinc-400 text-sm uppercase tracking-widest mb-1">
      My activity
    </p>
    <h2 class="text-3xl font-bold text-white">Contributions</h2>
  </div>

  <div class="bg-zinc-800 border border-zinc-700 rounded-xl p-6 space-y-4">
    <!-- Total count -->
    <p class="text-zinc-400 text-sm">
      <span class="text-white font-semibold">{total}</span> contributions in the last
      year
    </p>

    <!-- Graph -->
    <div class="flex gap-0.75 overflow-x-auto pb-2 scrollbar-none">
      <!-- Day labels -->
      <div class="flex flex-col gap-0.75 pr-2 shrink-0 mt-px">
        {
          days.map((day) => (
            <span class="text-zinc-500 text-xs h-3 leading-3">{day}</span>
          ))
        }
      </div>

      <!-- Weeks -->
      {
        weeks.map((week) => (
          <div class="flex flex-col gap-0.75 shrink-0">
            {week.contributionDays.map((day) => (
              <div
                class={`w-3 h-3 rounded-sm ${getColor(day.contributionCount)}`}
                title={`${day.date}: ${day.contributionCount} contributions`}
              />
            ))}
          </div>
        ))
      }
    </div>

    <!-- Legend -->
    <div class="flex items-center gap-2 text-zinc-500 text-xs">
      <span>Less</span>
      <div class="w-3 h-3 rounded-sm bg-zinc-700"></div>
      <div class="w-3 h-3 rounded-sm bg-indigo-900"></div>
      <div class="w-3 h-3 rounded-sm bg-indigo-700"></div>
      <div class="w-3 h-3 rounded-sm bg-indigo-500"></div>
      <div class="w-3 h-3 rounded-sm bg-indigo-400"></div>
      <span>More</span>
    </div>
  </div>
</section>
