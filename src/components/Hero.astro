---
import { GITHUB_USERNAME } from "../lib/github";

const avatarUrl = `https://github.com/${GITHUB_USERNAME}.png`;
---

<section class="flex flex-col md:flex-row items-center gap-10 md:gap-16 py-8">
    <!-- Avatar -->
    <img
        src={avatarUrl}
        alt="Profile picture"
        class="w-36 h-36 rounded-full ring-4 ring-zinc-700 shrink-0"
    />

    <!-- Text -->
    <div class="space-y-4">
        <div>
            <p class="text-zinc-400 text-sm uppercase tracking-widest mb-1">
                Hey. I'm
            </p>
            <h1 class="text-4xl font-bold text-white">Javier</h1>
            <p class="text-xl text-indigo-400 font-medium mt-1">
                Backend Developer/Engineer
            </p>
        </div>

        <p class="text-zinc-400 max-w-prose leading-relaxed">
            I build fast, accessible, and well-crafted microservices and APIs.
            Passionate about clean code, performance and scalability. Always
            eager to learn new technologies and improve my skills.
        </p>
        <!-- Links -->
        <div class="flex gap-4 pt-2">
            <a
                href={`https://github.com/${GITHUB_USERNAME}`}
                target="_blank"
                class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-sm rounded-lg transition-colors"
                >GitHub</a
            >
            <a
                href="/resume.pdf"
                class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-sm rounded-lg transition-colors"
                >Resume</a
            >
        </div>
    </div>
</section>
